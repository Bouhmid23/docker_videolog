FROM python:3.11-slim

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi==0.104.1 \
    uvicorn==0.24.0 \
    motor==3.3.2 \
    redis==5.0.1 \
    pymongo==4.6.0 \
    livekit==0.11.1 \
    livekit-api==0.6.0

COPY webhook.py .

CMD ["python", "-u", "-m", "uvicorn", "webhook:app", "--host", "0.0.0.0", "--port", "8088"]
