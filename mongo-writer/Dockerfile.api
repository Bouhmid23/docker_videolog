FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    motor==3.3.2 \
    redis==5.0.1 \
    pymongo==4.6.0 \
    fastapi==0.104.1 \
    uvicorn==0.24.0 \
    livekit==0.11.1 \
    livekit-api==0.6.0 \
    minio==7.2.0 \
    python-dotenv==1.0.0

COPY api.py .

CMD ["python", "-u", "-m", "uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
