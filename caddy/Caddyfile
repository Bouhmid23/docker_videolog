{$DOMAIN} {
	redir https://dashboard.{$DOMAIN}{uri} permanent
}

dashboard.{$DOMAIN} {
	basic_auth {
		{$DASHBOARD_AUTH_USER} {$DASHBOARD_AUTH_HASH}
	}
	@api_events path /api/events
	handle @api_events {
		uri strip_prefix /api
		reverse_proxy dashboard-api:8000 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy dashboard:80
	}
}

livekit.{$DOMAIN} {
	reverse_proxy livekit:7880
}

api.{$DOMAIN} {
	@mobile_api path /token /mobile/*
	handle @mobile_api {
		reverse_proxy dashboard-api:8000
	}
	@livekit_webhook path /webhook/livekit
	handle @livekit_webhook {
		reverse_proxy dashboard-api:8000
	}
	handle {
		respond "Not Found" 404
	}
}

minio.{$DOMAIN} {
	reverse_proxy minio:9000
}
