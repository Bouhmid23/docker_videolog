# ============================================================
#  VIDEOLOG POC — Variables d'environnement
#  Copier ce fichier en .env et ajuster les valeurs
#  Ne jamais versionner .env (ajouté dans .gitignore)
# ============================================================

# ── Room ──────────────────────────────────────────────────────
VIDEOLOG_ROOM=poc-room
# Liste optionnelle de rooms surveillees par telemetry-agent.
# Exemple: VIDEOLOG_ROOMS=poc-room,session-002,session-003
VIDEOLOG_ROOMS=poc-room

# ── LiveKit ───────────────────────────────────────────────────
LIVEKIT_API_KEY=REMPLACER_PAR_CLE_ALEATOIRE
LIVEKIT_API_SECRET=REMPLACER_PAR_SECRET_ALEATOIRE
# En production : wss://livekit.videolog.app ; en local : ws://localhost:7880
LIVEKIT_PUBLIC_URL=wss://livekit.videolog.app
# En production sur VPS : true + IPv4 publique du VPS (laisser false en local)
LIVEKIT_USE_EXTERNAL_IP=false
LIVEKIT_NODE_IP=
DOMAIN=videolog.app
FIREBASE_PROJECT_ID=your-firebase-project-id
# Place the Firebase service-account JSON in this host directory (never commit it).
FIREBASE_SECRETS_DIR=./secrets
DASHBOARD_AUTH_USER=admin
# Générer avec : docker run --rm caddy:2-alpine caddy hash-password --plaintext 'mot-de-passe-fort'
DASHBOARD_AUTH_HASH=REMPLACER_PAR_HASH_BCRYPT_CADDY

# ── MinIO ─────────────────────────────────────────────────────
MINIO_ROOT_USER=REMPLACER_PAR_IDENTIFIANT_ALEATOIRE
MINIO_ROOT_PASSWORD=REMPLACER_PAR_SECRET_ALEATOIRE
# En local, utiliser http://localhost:9000 ; en production, https://minio.videolog.app
MINIO_PUBLIC_URL=https://minio.videolog.app

# MongoDB : utiliser uniquement des caractères alphanumériques pour les secrets d'URI.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=REMPLACER_PAR_SECRET_ALEATOIRE
MONGO_APP_USER=videolog_app
MONGO_APP_PASSWORD=REMPLACER_PAR_SECRET_ALEATOIRE

# ── MongoDB ───────────────────────────────────────────────────
MONGO_INITDB_DATABASE=videolog

# ── Egress ────────────────────────────────────────────────────
# Manual mobile start/stop only; participant-count based automatic recording is disabled.
RECORDING_MODE=manual
# Mandatory server-side maximum duration; Egress is stopped even without a mobile stop request.
RECORDING_MAX_DURATION_SECONDS=180
# Délai de grâce avant stop auto (secondes, seulement en mode automatic)
STOP_GRACE_DELAY=10
# Nombre minimum (minimum 2, seulement en mode automatic)
RECORD_MIN_PARTICIPANTS=2
# URL publique de MinIO (liens de téléchargement signés)

# ── Telemetry ─────────────────────────────────────────────────
TELEMETRY_INTERVAL=0.5

# ── Sport / Recording ─────────────────────────────────────────────────────────
RECORD_MIN_PARTICIPANTS=2   # Nombre minimum de coachs/trainees télémétrés (minimum 2)
STOP_GRACE_DELAY=10         # Secondes avant arrêt si < seuil

# Seuils d'alertes sportives
ALERT_HR_MAX=185            # FC max (bpm)
ALERT_HR_REST=50            # FC trop basse (bpm)
ALERT_SPEED_MAX=40          # Vitesse max (km/h)

# Scénario simulateur: run | cycling | interval
SCENARIO=run

# ── Back-office & Invitations ─────────────────────────────────
APP_PUBLIC_URL=https://app.videolog.app
# Compatibilité temporaire avec les anciennes rooms sans org_id (false en prod)
LEGACY_OPEN_ROOMS=false

# Configuration Web Firebase (build du back-office)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Relais SMTP pour les e-mails d'invitation (ex. Brevo : smtp-relay.brevo.com:587)
# Laisser SMTP_HOST vide pour afficher les liens d'invitation à copier dans le back-office
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Videolog <noreply@videolog.app>
SMTP_USE_TLS=false
