# ============================================================
#  VIDEOLOG POC — Variables d'environnement
#  Copier ce fichier en .env et ajuster les valeurs
#  Ne jamais versionner .env (ajouté dans .gitignore)
# ============================================================

# ── Room ──────────────────────────────────────────────────────
VIDEOLOG_ROOM=poc-room
# Liste optionnelle de rooms surveillees par telemetry-agent.
# Exemple: VIDEOLOG_ROOMS=poc-room,session-002,session-003
VIDEOLOG_ROOMS=poc-room

# ── LiveKit ───────────────────────────────────────────────────
LIVEKIT_API_KEY=REMPLACER_PAR_CLE_ALEATOIRE
LIVEKIT_API_SECRET=REMPLACER_PAR_SECRET_ALEATOIRE
# En production : wss://lk.votre-domaine.tld ; en local : ws://localhost:7880
LIVEKIT_PUBLIC_URL=wss://lk.example.invalid
DOMAIN=example.invalid
DASHBOARD_AUTH_USER=admin
# Générer avec : docker run --rm caddy:2-alpine caddy hash-password --plaintext 'mot-de-passe-fort'
DASHBOARD_AUTH_HASH=REMPLACER_PAR_HASH_BCRYPT_CADDY

# ── MinIO ─────────────────────────────────────────────────────
MINIO_ROOT_USER=REMPLACER_PAR_IDENTIFIANT_ALEATOIRE
MINIO_ROOT_PASSWORD=REMPLACER_PAR_SECRET_ALEATOIRE
# En local, utiliser http://localhost:9000 ; sur VPS, https://storage.<domaine>
MINIO_PUBLIC_URL=https://storage.example.invalid

# MongoDB : utiliser uniquement des caractères alphanumériques pour les secrets d'URI.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=REMPLACER_PAR_SECRET_ALEATOIRE
MONGO_APP_USER=videolog_app
MONGO_APP_PASSWORD=REMPLACER_PAR_SECRET_ALEATOIRE

# ── MongoDB ───────────────────────────────────────────────────
MONGO_INITDB_DATABASE=videolog

# ── Egress ────────────────────────────────────────────────────
# Délai de grâce avant stop auto (secondes)
STOP_GRACE_DELAY=10
# Nombre minimum de coachs/trainees télémétrés pour déclencher l'enregistrement (minimum 2)
RECORD_MIN_PARTICIPANTS=2
# URL publique de MinIO (liens de téléchargement signés)

# ── Telemetry ─────────────────────────────────────────────────
TELEMETRY_INTERVAL=0.5

# ── Sport / Recording ─────────────────────────────────────────────────────────
RECORD_MIN_PARTICIPANTS=2   # Nombre minimum de coachs/trainees télémétrés (minimum 2)
STOP_GRACE_DELAY=10         # Secondes avant arrêt si < seuil

# Seuils d'alertes sportives
ALERT_HR_MAX=185            # FC max (bpm)
ALERT_HR_REST=50            # FC trop basse (bpm)
ALERT_SPEED_MAX=40          # Vitesse max (km/h)

# Scénario simulateur: run | cycling | interval
SCENARIO=run
